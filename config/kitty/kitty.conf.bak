# Font
# font_family      Adwaita Mono Nerd Font
# bold_font        Adwaita Mono Nerd Font Bold
# italic_font      Adwaita Mono Nerd Font Italic
# bold_italic_font Adwaita Mono Nerd Font Bold Italic

cursor_shape beam
# font_family      Space Mono
# bold_font        Space Mono Bold
# italic_font      Space Mono Italic
# bold_italic_font Space Mono Bold Italic
font_size        13.0

# Window
background_opacity 0.65

# Padding
window_padding_width 16 20

# Theme
include ~/.config/kitty/catppuccin-mocha.conf

# Kitty stuff
cursor_trail 1
cursor_trail_decay 0.2 0.3


# BEGIN_KITTY_FONTS
font_family      family='SpaceMono Nerd Font' style=Bold features=-liga
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS