// Layout and desktop config

layout {
    background-color "transparent"
    gaps 20

    shadow {
        off
        softness 4
        spread 0
        color "#1a1a1aee"
    }

    center-focused-column "never"

    focus-ring {
        width 2

        //active-gradient from="#b4befe" to="#eff1f5" angle=45
        //inactive-color "#585b70"
        active-gradient from="#dfb991" to="#e8dccb" angle=45
        inactive-color "#3b2c22"
    }

}

overview {
    workspace-shadow {
        off
    }
}
