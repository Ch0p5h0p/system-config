// Input and output config

output "eDP-1" {
    mode "1920x1080@120"
    scale 1
}

input {
    focus-follows-mouse max-scroll-amount="0%"

    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        natural-scroll
    }
}
gestures {
    hot-corners {
        off
    }
}

cursor {
    xcursor-theme "Adwaita"
    //xcursor-size 24
}
